<?xml version="1.0" encoding="utf-8"?>
<!-- Login tokens never leave the device; theme and city preferences may be backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
