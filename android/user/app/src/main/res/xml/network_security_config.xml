<?xml version="1.0" encoding="utf-8"?>
<!-- The backend and the demo server are served over plain HTTP (see docker-compose.yml); use HTTPS in production. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
