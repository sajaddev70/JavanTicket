# SakooTicket production environment. Copy to .env next to docker-compose.yml and fill in the CHANGE_ME values:
#   cp .env.example .env && chmod 600 .env
# .env is git-ignored; never commit it. Generate secrets on the server with: openssl rand -hex 32

# ---------- Secrets (required) ----------
# Database password for the PostgreSQL container. Only set once: changing it later does NOT change the password
# inside an existing database volume.
DB_PASSWORD=CHANGE_ME_openssl_rand_hex_32
# JWT signing key (64 hex characters). Changing it logs every user and admin out.
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# ---------- Public addresses (built into the frontends; rebuild with --build after changing) ----------
PUBLIC_API_URL=https://sakooticket.ir/api/v1
PUBLIC_USER_SITE_URL=https://sakooticket.ir
# Browser origins allowed to call the API (comma-separated, no spaces, no trailing slash).
CORS_ALLOWED_ORIGINS=https://sakooticket.ir,https://www.sakooticket.ir,https://panel.sakooticket.ir,https://adm.sakooticket.ir

# ---------- SMS (Kavenegar) ----------
# WARNING: while KAVENEGAR_API_KEY is empty the login code is the fixed dev code (1111) for every phone number,
# which lets anyone log in as the super admin. Set a real key before opening the site to the public.
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=otp
KAVENEGAR_SENDER=

# ---------- Payments ----------
# "none" until a real gateway is integrated. "dev" (simulated bank) is disabled by the prod profile anyway.
PAYMENT_MODE=none

# ---------- Database ----------
DB_NAME=youth_event
DB_USERNAME=postgres

# ---------- Demo data ----------
# Fills an EMPTY database with demo events/customers. Keep false for a real launch.
DEMO_SEED_ENABLED=false
DEMO_SEED_RESEED=false

# ---------- Optional ----------
APP_LOG_LEVEL=INFO
# Docker mirror for base images (ParsPack). Change if the server uses another mirror.
REGISTRY=docker.abrha.net
# Host ports, always bound to 127.0.0.1 (nginx is the only public entry point). Change only on conflicts,
# and update the upstreams in /etc/nginx/sites-available/00-sakooticket-common.conf to match.
BACKEND_PORT=8080
ADMIN_PORT=3000
USER_PORT=3001
BACKEND_JAVA_OPTS=-XX:MaxRAMPercentage=75
