# Copy to .env next to docker-compose.yml and fill in.

# ParsPack Docker mirror
REGISTRY=docker.abrha.net

DB_NAME=youth_event
DB_USERNAME=postgres
DB_PASSWORD=1234

# Long random hex string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me

SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=otp
# Sender line for ticket SMS (empty = the account's default line)
KAVENEGAR_SENDER=
PAYMENT_MODE=none

# Demo data (events, orders, tickets, site content...) on a fresh database; it never overwrites real data.
DEMO_SEED_ENABLED=true
# Reload the demo when a new seed version ships (only on databases the demo filled)
DEMO_SEED_RESEED=true
# true for ONE start = replace the current data with the demo (admins are kept), then set back to false
DEMO_SEED_FORCE=false

# Backend address as the browser sees it (baked into the frontends at build time; rebuild after changing)
# Behind nginx (deploy/README.md): https://sakooticket.ir/api/v1
PUBLIC_API_URL=http://SERVER_IP:8081/api/v1
# User site address, used by links in the admin panel and as the return address after online payment
# Behind nginx (deploy/README.md): https://sakooticket.ir
PUBLIC_USER_SITE_URL=http://SERVER_IP:3003

# Address the ports below are published on. Behind nginx use 127.0.0.1 so they are not reachable from outside.
BIND_ADDRESS=0.0.0.0
BACKEND_PORT=8081
ADMIN_PORT=3002
USER_PORT=3003
